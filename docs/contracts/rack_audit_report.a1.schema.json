{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wavenumber-eng/wn-rack/docs/contracts/rack_audit_report.a1.schema.json",
  "title": "Rack Audit Report A1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "version",
    "root",
    "strict",
    "signoff_strata",
    "passed",
    "failures"
  ],
  "properties": {
    "type": {
      "const": "rack.audit_report"
    },
    "version": {
      "const": "a1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "strict": {
      "type": "boolean"
    },
    "signoff_strata": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "target_stratum": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure"
      }
    },
    "declarations": {
      "$ref": "#/$defs/declarations"
    }
  },
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "path"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "stratum": {
          "type": "string",
          "minLength": 1
        },
        "subtest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_files",
        "self_declared",
        "without_rack",
        "outside_strata",
        "strata",
        "requirements"
      ],
      "properties": {
        "test_files": {
          "type": "integer",
          "minimum": 0
        },
        "self_declared": {
          "type": "integer",
          "minimum": 0
        },
        "without_rack": {
          "type": "integer",
          "minimum": 0
        },
        "outside_strata": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "strata": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "test_files",
              "self_declared",
              "require_declared",
              "without_rack"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "test_files": {
                "type": "integer",
                "minimum": 0
              },
              "self_declared": {
                "type": "integer",
                "minimum": 0
              },
              "require_declared": {
                "type": "boolean"
              },
              "without_rack": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "failing"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "failing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
